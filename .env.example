# Copy this file to .env and replace every CHANGE_ME value before starting Docker.
APP_PORT=8080
DB_PORT=3306
DB_NAME=news_portal_db

# Dedicated application account created by MySQL on a fresh database volume.
DB_USER=news_portal_app
DB_PASS=CHANGE_ME_APPLICATION_PASSWORD
MYSQL_APP_USER=news_portal_app
MYSQL_APP_PASSWORD=CHANGE_ME_APPLICATION_PASSWORD

# MySQL administrative password; use a different strong value.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Safe for the provided localhost-only port binding. The page closes after an admin exists.
ALLOW_ADMIN_SETUP=1
